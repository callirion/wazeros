import asyncio
import hashlib
import pytest
from src import passwords

@pytest.mark.parametrize("password", ["Test-only-password-2026!", "caf\u00e9-test-2026!", "long-" * 40])
def test_existing_hash_compatibility_without_hashlib_pbkdf2(monkeypatch, password):
    salt = bytes(range(16))
    expected = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 600000).hex()
    encoded = f"pbkdf2_sha256$600000${salt.hex()}${expected}"
    monkeypatch.delattr(hashlib, "pbkdf2_hmac")
    assert passwords.verify(encoded, password)
    assert asyncio.run(passwords.verify_async(encoded, password))
    assert not passwords.verify(encoded, "incorrect-password")


def test_encode_random_salts_and_async_roundtrip():
    password = "Test-only-password-2026!"
    a = passwords.encode(password)
    b = asyncio.run(passwords.encode_async(password))
    assert a != b
    assert a.startswith("pbkdf2_sha256$600000$")
    assert passwords.verify(a, password)
    assert asyncio.run(passwords.verify_async(b, password))

@pytest.mark.parametrize("encoded", [None, "", "$argon2id$legacy", "pbkdf2_sha256$100000$00$00", "pbkdf2_sha256$600000$" + "zz"*16 + "$" + "00"*32])
def test_invalid_hashes_rejected(encoded):
    assert not passwords.verify(encoded, "Test-only-password-2026!")


def test_crypto_failure_propagates(monkeypatch):
    encoded = "pbkdf2_sha256$600000$" + "00"*16 + "$" + "00"*32
    def broken(*args):
        raise RuntimeError("test backend failure")
    monkeypatch.setattr(passwords, "_derive", broken)
    with pytest.raises(RuntimeError):
        passwords.verify(encoded, "Test-only-password-2026!")
