{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wazeros",
  "main": "main.py",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "staging",
    "FRONTEND_URL": "http://localhost:3000",
    "LEGAL_VERSION": "draft-v043-purchase-2026-10-09",
    "MAIL_FROM": "",
    "REGISTRATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wazeros-m1-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
