{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wazeros",
  "main": "main.py",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "staging",
    "FRONTEND_URL": "https://wazeros.taceyt8.workers.dev",
    "LEGAL_VERSION": "draft-v043-purchase-2026-10-09",
    "MAIL_FROM": "",
    "REGISTRATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wazeros-m1-staging",
      "database_id": "eb692719-3d82-4ee9-a518-7a3773705219",
      "migrations_dir": "migrations"
    }
  ]
}
